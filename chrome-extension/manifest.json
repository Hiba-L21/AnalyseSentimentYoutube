{
  "manifest_version": 3,
  "name": "YouTube Sentiment Analyzer",
  "version": "1.0.0",
  "description": "Analyse le sentiment des commentaires YouTube (Négatif / Neutre / Positif)",

  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyser les commentaires"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}